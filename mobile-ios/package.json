{
  "name": "soa-mobile-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Son of Anton \u2014 native iOS shell (Capacitor) bundling the /m/ mobile client",
  "scripts": {
    "sync-web": "node scripts/sync-web.js",
    "build": "npm run sync-web && npx cap sync ios && node scripts/fix-spm.js",
    "open": "npx cap open ios",
    "fix-spm": "node scripts/fix-spm.js"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@capacitor/cli": {
      "@xmldom/xmldom": "0.9.12"
    },
    "@xmldom/xmldom": {
      "@xmldom/xmldom": "0.9.12"
    },
    "native-run": {
      "@xmldom/xmldom": "0.9.12"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
