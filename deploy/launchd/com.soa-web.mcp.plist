<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEVICE MCP LIBRARY (optional HTTP mode) — runs `scripts/soa-mcp serve`: the
  per-device skill/snippet library over MCP Streamable HTTP on
  127.0.0.1:6083/mcp. NOT needed for Claude Code / Codex, which launch
  `soa-mcp` over stdio themselves; load this only for a client that can only
  speak HTTP.

  Local only: loopback bind, loopback Host/Origin for this port, no
  forwarding/proxy headers (so the daemon's /preview/6083/ route — which the
  public tunnel reaches — is refused), and a bearer key from
  $SOA_WEB_STATE_DIR/mcp/http-key (0600, created on first start). See
  docs/soa-mcp.md.

  Paths use $HOME through /bin/sh so the plist carries no user-specific path.
  Load:   cp deploy/launchd/com.soa-web.mcp.plist ~/Library/LaunchAgents/ &&
          launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.soa-web.mcp.plist
  Unload: launchctl bootout gui/$(id -u)/com.soa-web.mcp
  Log:    $SOA_WEB_STATE_DIR/logs/mcp.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.soa-web.mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>: "${SOA_WEB_STATE_DIR:=$HOME/.soa-web-local}"; export SOA_WEB_STATE_DIR; mkdir -p "$SOA_WEB_STATE_DIR/logs"; exec node "$HOME/.soa-web/scripts/soa-mcp" serve --port "${SOA_MCP_PORT:-6083}" >> "$SOA_WEB_STATE_DIR/logs/mcp.log" 2>&amp;1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
