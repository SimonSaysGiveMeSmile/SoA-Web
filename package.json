{
  "name": "soa-web",
  "version": "0.3.0",
  "private": true,
  "description": "Son of Anton, reimagined as a web app. Terminal sessions over WebSocket, TRON UI in the browser, zero desktop install.",
  "license": "GPL-3.0",
  "main": "server/src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "SOA_WEB_DEV=1 node server/src/index.js",
    "local": "node scripts/local.js",
    "selfhost": "node scripts/selfhost.js",
    "postinstall": "node scripts/fix-pty-perms.js",
    "test": "node --test server/test/*.test.js",
    "test:mobile": "node scripts/test-mobile.cjs",
    "test:voice": "node scripts/test-voice-toolbar.cjs",
    "test:usage": "node scripts/test-usage-widget.cjs",
    "vendor:terminal": "node scripts/vendor-mobile-terminal.js"
  },
  "dependencies": {
    "@xterm/headless": "5.5.0",
    "cookie": "^0.6.0",
    "express": "^4.19.2",
    "localtunnel": "^2.0.2",
    "node-pty": "^1.1.0-beta34",
    "qrcode": "^1.5.4",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
