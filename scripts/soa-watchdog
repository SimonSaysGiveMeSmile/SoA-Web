#!/bin/bash
#
# SoA-Web watchdog — keeps the PROD daemon (:7332, ~/.soa-web) AND its public
# tunnel alive, so the user never has to ask for a manual restore. Runs every
# 60s via com.soa-web.watchdog.
#
# Covers three failure modes:
#   1. Daemon DOWN  — process gone → restart immediately.
#   2. Daemon HUNG  — alive but unresponsive ~30s (vs merely load-starved, which
#                     it tolerates) → SIGTERM first so the detached tunnel
#                     survives and the restart re-adopts the SAME url; escalate
#                     to kickstart -k only if SIGTERM is ignored.
#   3. Tunnel ZOMBIE — daemon healthy but the cloudflared tunnel lost its edge
#                     connection (process alive, hostname NXDOMAIN). The daemon
#                     only watches for the tunnel PROCESS exiting, so it never
#                     notices. The watchdog re-checks tunnel routing and respawns
#                     it (rate-limited), then texts the new URL via soa-msg.
#
# LOAD-TOLERANT: this host runs many heavy Claude agents (load can exceed 100 on
# 10 cores). A busy daemon is not a dead daemon — never kill one that's merely
# slow, and retry tunnel probes before concluding the tunnel is gone.
#
# SAFETY: only ever touches the ONE daemon it is pointed at (SOA_WEB_LABEL /
# SOA_WEB_PORT / SOA_WEB_STATE_DIR). To stop by hand, bootout the watchdog
# FIRST, then the daemon.
#
# Instance-parameterized via env (defaults keep the legacy :7332 behaviour):
#   SOA_WEB_LABEL         launchd job to recover    (default com.soa-web.server)
#   SOA_WEB_PORT          health port               (default 7332)
#   SOA_WEB_STATE_DIR     lock/tunnel/logs root     (default ~/.soa-web)
#   SOA_WEB_MANAGE_TUNNEL 1 = also heal the tunnel  (default 1; set 0 when the
#                         channels self-healer owns the tunnel, e.g. :4010)
#   SOA_WATCHDOG_PROBES          re-probes before a live daemon counts as hung
#                                (default 5: 5 s sleep + up to 8 s curl each, ~30-65 s)
#   SOA_WATCHDOG_LOADED_MAX_S    while the HOST is overloaded (load1 >= ncpu x
#                                SOA_WATCHDOG_LOAD_PER_CPU, default 4) a daemon that is
#                                still getting CPU is starved, not hung: keep waiting
#                                up to this many seconds (default 180). One that makes
#                                no CPU progress for 3 probes is hung at once.
#   SOA_WATCHDOG_TERM_GRACE      seconds a SIGTERMed daemon gets to flush its tabs
#                                before kickstart -k (default 45; was 8)
#   SOA_WATCHDOG_HINTS_MAX_S     hard cap on the hints snapshot (default 40)
#
# Before it SIGTERMs a hung daemon it runs `soa-restart --hints-only`, which
# writes session-hints.json (each tab's agent + conversation, read off the
# process table) so the next boot resumes every tab on its exact thread even
# if the daemon never gets to flush. 2026-11-25 23:19: at load ~350 the daemon
# was SIGKILLed 8 s after SIGTERM, with no hints, and 26 tabs came back guessed.

set -u

LABEL="${SOA_WEB_LABEL:-com.soa-web.server}"
PORT="${SOA_WEB_PORT:-7332}"
STATE_DIR="${SOA_WEB_STATE_DIR:-$HOME/.soa-web}"
MANAGE_TUNNEL="${SOA_WEB_MANAGE_TUNNEL:-1}"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
# launchd on macOS, systemd user units on Linux (same labels).
# shellcheck source=lib/svc.sh
. "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/lib/svc.sh"
LOCK="$STATE_DIR/daemon.lock"
TUNJSON="$STATE_DIR/tunnel.json"
LOG="$STATE_DIR/logs/watchdog.log"
RESPAWN_MARK="$STATE_DIR/logs/.tunnel-respawn"
RESPAWN_MIN_GAP=300   # at most one tunnel respawn / 5 min (avoid URL-churn storms)
STRIKE_MARK="$STATE_DIR/logs/.tunnel-strike"   # consecutive failing cycles while cloudflared is alive
STRIKE_THRESHOLD=2    # demand this many consecutive failures before blaming a LIVE tunnel (kills load false-positives)

mkdir -p "$(dirname "$LOG")" 2>/dev/null

ts()  { date '+%Y-%m-%dT%H:%M:%S'; }
log() { echo "$(ts) $*" >> "$LOG" 2>/dev/null; }
now() { date +%s; }

ping_ok() { curl -fsS --max-time 8 "http://127.0.0.1:${PORT}/api/ping" >/dev/null 2>&1; }

live_owner() {
    local p
    p="$(sed -n 's/.*"pid":[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$LOCK" 2>/dev/null | head -1)"
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"
}

tunnel_url() { sed -n 's/.*"url":"\([^"]*\)".*/\1/p' "$TUNJSON" 2>/dev/null | head -1; }
tunnel_pid() { sed -n 's/.*"pid":[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$TUNJSON" 2>/dev/null | head -1; }

# Detect + recover a zombie tunnel. Only runs when the daemon itself is healthy.
check_tunnel() {
    # Private install: there is no public tunnel to heal, and none may be opened.
    [ "${SOA_CHANNELS_PUBLIC:-1}" = 0 ] && return 0
    local url; url="$(tunnel_url)"
    [ -z "$url" ] && return 0                       # no tunnel configured

    # Routing? Retry — under heavy host load DNS/curl flake without the tunnel
    # actually being dead. Generous timeout so a loaded host (a full fleet of
    # agents) doesn't false-trip a respawn and churn the public URL.
    local i
    for i in 1 2 3; do
        if curl -fsS --max-time 15 "${url}/api/ping" >/dev/null 2>&1; then
            rm -f "$STRIKE_MARK" 2>/dev/null          # healthy → clear the strike count
            return 0
        fi
        sleep 3
    done

    # Routing failed. Distinguish a REAL zombie from a transient load blip: only
    # respawn immediately when cloudflared is actually DEAD. While it is alive
    # (and the daemon is healthy — we only reach here after ping_ok), a failed
    # curl is far more likely host load than a dead edge, so demand
    # STRIKE_THRESHOLD consecutive failing cycles before churning the URL.
    local tpid; tpid="$(tunnel_pid)"
    if [ -n "$tpid" ] && kill -0 "$tpid" 2>/dev/null; then
        local strikes=0
        [ -f "$STRIKE_MARK" ] && strikes="$(cat "$STRIKE_MARK" 2>/dev/null || echo 0)"
        strikes=$((strikes + 1))
        echo "$strikes" > "$STRIKE_MARK"
        if [ "$strikes" -lt "$STRIKE_THRESHOLD" ]; then
            log "tunnel ${url} unreachable but cloudflared (pid ${tpid}) alive — strike ${strikes}/${STRIKE_THRESHOLD}, deferring respawn (no URL churn)"
            return 0
        fi
        log "tunnel ${url} unreachable ${strikes} cycles though cloudflared alive — treating as zombie"
    else
        log "tunnel ${url} cloudflared process dead — respawning immediately"
    fi
    rm -f "$STRIKE_MARK" 2>/dev/null

    # Rate-limit respawns so a flapping tunnel doesn't churn URLs every minute.
    local n last; n="$(now)"; last=0
    [ -f "$RESPAWN_MARK" ] && last="$(cat "$RESPAWN_MARK" 2>/dev/null || echo 0)"
    if [ $((n - last)) -lt "$RESPAWN_MIN_GAP" ]; then
        log "tunnel ${url} respawn suppressed — last respawn <${RESPAWN_MIN_GAP}s ago"
        return 0
    fi
    echo "$n" > "$RESPAWN_MARK"

    log "tunnel ${url} — respawning cloudflared"
    local oldpid; oldpid="$(tunnel_pid)"
    [ -n "$oldpid" ] && kill "$oldpid" 2>/dev/null

    local cflog="$STATE_DIR/logs/cf-respawn.log"
    : > "$cflog"
    nohup cloudflared tunnel --url "http://localhost:${PORT}" >"$cflog" 2>&1 &
    local newpid=$!
    local newurl=""
    for i in $(seq 1 20); do
        # -a: cloudflared writes control bytes to the log, so without it BSD grep
        # reports "Binary file … matches" instead of the URL — that garbage string
        # was landing in tunnel.json and breaking the mobile bridge re-pair.
        # Exclude api.trycloudflare.com — cloudflared prints that control-plane
        # host ("Requesting new quick Tunnel on trycloudflare.com…") BEFORE the
        # real quick-tunnel hostname, and a bare head -1 was capturing the API
        # host as the URL → garbage written to tunnel.json (dead backend).
        newurl="$(grep -aoE 'https://[a-z0-9-]+\.trycloudflare\.com' "$cflog" 2>/dev/null | grep -v '://api\.' | head -1)"
        [ -n "$newurl" ] && break
        sleep 2
    done

    if [ -n "$newurl" ]; then
        printf '{"provider":"cloudflared","url":"%s","pid":%s,"port":%s,"startedAt":%s}\n' \
            "$newurl" "$newpid" "$PORT" "${n}000" > "$TUNJSON"
        log "tunnel respawned → ${newurl} (pid ${newpid})"
        # Tell the LIVE daemon to trust the new tunnel origin for /ws upgrades,
        # in-place — no restart, no PTY/agent loss. Without this the fresh
        # *.trycloudflare.com host 403s every WebSocket and the browser shows a
        # dead terminal even though the fleet is fine (the recurring breakage).
        dpid="$(live_owner)"
        [ -n "$dpid" ] && kill -HUP "$dpid" 2>/dev/null && \
            log "signaled daemon ($dpid) SIGHUP → register origin ${newurl}"
        command -v soa-msg >/dev/null 2>&1 && \
            soa-msg "🔁 Tunnel auto-recovered: https://s0a.app/?backend=${newurl}" >/dev/null 2>&1
    else
        log "tunnel respawn failed to capture URL (host likely overloaded) — retry next cycle"
    fi
}

# ── Daemon health ─────────────────────────────────────────────────────────────
if ping_ok; then
    [ "$MANAGE_TUNNEL" = 1 ] && check_tunnel   # daemon fine — heal tunnel unless the channels self-healer owns it
    exit 0
fi

PID="$(live_owner)"

if [ -z "$PID" ]; then
    if [ "$(uname -s)" = Darwin ] && [ -e "$PLIST" ] && ! svc_loaded "$LABEL"; then
        log "daemon down + job not loaded — bootstrap"
        svc_load "$LABEL" >> "$LOG" 2>&1
    else
        log "daemon down (no live lock owner) — kickstart"
        svc_kick "$LABEL" >> "$LOG" 2>&1
    fi
    sleep 3; log "post-recovery tunnel: $(tunnel_url)"
    exit 0
fi

# Alive but first probe failed — may be load-starved. Re-probe; on an
# overloaded HOST a slow daemon is the norm, not a hang, so wait much longer.
host_overloaded() {
    local load ncpu per
    load="$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')"
    [ -n "$load" ] || load="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
    ncpu="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 8)"
    per="${SOA_WATCHDOG_LOAD_PER_CPU:-4}"
    [ -n "$load" ] && awk -v l="$load" -v n="$ncpu" -v p="$per" 'BEGIN{exit !(l >= n*p)}'
}
# CPU time the daemon has used, in centiseconds ("MM:SS.ss" / "H:MM:SS.ss").
cpu_cs() { ps -o time= -p "$1" 2>/dev/null | awk -F: '{s=0; for(i=1;i<=NF;i++) s=s*60+$i; printf "%d", s*100}'; }
if host_overloaded; then
    MAX="${SOA_WATCHDOG_LOADED_MAX_S:-180}"
    log "daemon pid $PID slow to answer on an overloaded host (load $(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')) — waiting up to ${MAX}s while it still gets CPU"
    T0=$SECONDS; LAST="$(cpu_cs "$PID")"; STILL=0
    while [ $((SECONDS - T0)) -lt "$MAX" ]; do
        sleep 5
        if ping_ok; then exit 0; fi
        kill -0 "$PID" 2>/dev/null || break
        NOW="$(cpu_cs "$PID")"
        if [ -n "$NOW" ] && [ -n "$LAST" ] && [ "$NOW" -gt "$LAST" ]; then STILL=0; else STILL=$((STILL + 1)); fi
        LAST="$NOW"
        if [ "$STILL" -ge 3 ]; then log "daemon pid $PID made no CPU progress for 3 probes — hung, not starved"; break; fi
    done
else
    for _ in $(seq 1 "${SOA_WATCHDOG_PROBES:-5}"); do
        sleep 5
        if ping_ok; then exit 0; fi
    done
fi

# The wait can be minutes long: act only on the daemon we started judging.
if [ "$(live_owner)" != "$PID" ]; then
    log "daemon pid changed while probing ($PID -> $(live_owner)) — nothing to do this cycle"
    exit 0
fi

# Record every tab's agent + conversation BEFORE we kill anything: the hung
# daemon may never get to flush, and the next boot applies these hints.
RESTART_CLI="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/soa-restart"
if [ -x "$RESTART_CLI" ] && [ "${SOA_WATCHDOG_HINTS:-1}" = 1 ]; then
    # Hard cap: a paging host can stall lsof/ps/claude; the restart must not wait on it.
    SOA_WEB_STATE_DIR="$STATE_DIR" perl -e 'alarm shift; exec @ARGV' "${SOA_WATCHDOG_HINTS_MAX_S:-40}" \
        "$RESTART_CLI" --hints-only --port "$PORT" 2>&1 | tail -1 | sed 's/^/hints: /' >> "$LOG"
fi
[ "$(live_owner)" = "$PID" ] || { log "daemon pid $PID gone before SIGTERM — leaving recovery to the next cycle"; exit 0; }

GRACE="${SOA_WATCHDOG_TERM_GRACE:-45}"
log "daemon pid $PID alive but unresponsive — SIGTERM, ${GRACE}s to flush (preserve tunnel $(tunnel_url))"
kill -TERM "$PID" 2>/dev/null
for _ in $(seq 1 "$GRACE"); do sleep 1; kill -0 "$PID" 2>/dev/null || break; done

if kill -0 "$PID" 2>/dev/null; then
    log "pid $PID still alive ${GRACE}s after SIGTERM — kickstart -k (tunnel may churn)"
    svc_restart "$LABEL" >> "$LOG" 2>&1
else
    svc_kick "$LABEL" >> "$LOG" 2>&1
    log "restarted via SIGTERM+kickstart"
fi
sleep 3; log "post-recovery tunnel: $(tunnel_url)"
exit 0
