#!/usr/bin/env node
/**
 * soa-fleet-restore-watch — self-recovery layer for a fleet COLLAPSE.
 *
 * boot-resume rehydrates the fleet on restart, but a boot race or a bad
 * tabs.json can leave the daemon HEALTHY yet holding only the lone default tab
 * while the real fleet is gone ("all tabs gone": 2026-08-06, 2026-08-14,
 * 2026-11-25). On a timer this compares the LIVE fleet (/api/tabs, loopback)
 * with the protected tabs.json.lastgood snapshot, and when the daemon answers
 * but the fleet has collapsed (<= 1 tab) while lastgood holds a real fleet
 * (>= 2), it calls the daemon's own POST /api/fleet/restore — the Time Machine
 * Restore path — and notifies the user.
 *
 * Why /api/fleet/restore and not soa-restore-fleet: the latter spawns through
 * `soa-sessions spawn`, which needs the Fleet Manager entitlement, so on an
 * unlicensed install every spawn failed while this watcher still logged
 * "done (18 spawned)" (2026-11-25). The endpoint is not entitlement-gated,
 * skips cwds that are already open (as a multiset), and resumes each tab's own
 * Claude session.
 *
 * Which daemon: the state dir is SOA_WEB_STATE_DIR, else whichever known state
 * dir holds the daemon.lock of a LIVE process (newest start wins). Guessing a
 * fixed path watched a previous install's state for a day.
 *
 * Safe by construction (runs unattended every 60 s):
 *   - no-op unless the daemon answers /api/tabs; liveness is watchdog-4010's job
 *   - ignored until the daemon is past its rehydrate window (MIN_UPTIME)
 *   - debounced: the collapse must persist DEBOUNCE before acting
 *   - cooldown between restores
 *   - respects a user close-all (tabs.json closedByUser) — unless it is the
 *     shutdown signature: no explicit close behind it and written seconds
 *     after the last healthy snapshot (same rule as tabPersist)
 *   - the endpoint only ever OPENS tabs
 *
 * Env:
 *   SOA_FLEET_RESTORE_ENABLE=0        kill switch (default on)
 *   SOA_FLEET_RESTORE_DRY=1           detect + log, don't restore
 *   SOA_FLEET_RESTORE_COOLDOWN_MS     min gap between restores (default 600000)
 *   SOA_FLEET_RESTORE_MIN_UPTIME_MS   ignore a collapse until the daemon is this old (default 90000)
 *   SOA_FLEET_RESTORE_DEBOUNCE_MS     collapse must persist this long (default 45000)
 *   SOA_WEB_STATE_DIR                 state dir override
 *   SOA_WEB_SESSION_TOKEN             sent as Bearer when the daemon runs in token mode
 */
'use strict';

const fs = require('fs');
const path = require('path');
const os = require('os');
const http = require('http');
const { execFileSync } = require('child_process');

const COLLAPSE_MAX = 1;
const MIN_HEALTHY = 2;           // mirrors tabPersist MIN_HEALTHY_TABS
const TOMBSTONE_SUSPECT_MS = 15000; // mirrors tabPersist TOMBSTONE_SUSPECT_MS

function cfg(env = process.env) {
    const int = (k, d) => parseInt(env[k] || String(d), 10);
    return {
        enabled: env.SOA_FLEET_RESTORE_ENABLE !== '0',
        dry: env.SOA_FLEET_RESTORE_DRY === '1',
        cooldownMs: int('SOA_FLEET_RESTORE_COOLDOWN_MS', 10 * 60 * 1000),
        minUptimeMs: int('SOA_FLEET_RESTORE_MIN_UPTIME_MS', 90 * 1000),
        debounceMs: int('SOA_FLEET_RESTORE_DEBOUNCE_MS', 45 * 1000),
    };
}

function readJson(p) { try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch (_) { return null; } }
function tabCount(obj) { return (obj && Array.isArray(obj.tabs)) ? obj.tabs.length : 0; }

function pidAlive(pid) {
    if (!Number.isInteger(pid) || pid <= 0) return false;
    try { process.kill(pid, 0); return true; } catch (e) { return e && e.code === 'EPERM'; }
}

// Resolve the LIVE daemon's state dir. Explicit env wins; otherwise pick the
// candidate whose daemon.lock names a running process (newest start first).
function resolveStateDir({ env = process.env, home = os.homedir(), alive = pidAlive } = {}) {
    if (env.SOA_WEB_STATE_DIR && env.SOA_WEB_STATE_DIR.trim()) {
        return path.resolve(env.SOA_WEB_STATE_DIR.replace(/^~(?=$|\/)/, home));
    }
    const candidates = [
        path.join(home, '.s0a-local', 'state'),
        path.join(home, '.soa-web-local'),
        path.join(home, '.soa-web'),
    ];
    const live = [];
    for (const dir of candidates) {
        const lock = readJson(path.join(dir, 'daemon.lock'));
        if (lock && alive(lock.pid)) live.push({ dir, startedAt: Date.parse(lock.startedAt) || 0 });
    }
    if (live.length) return live.sort((a, b) => b.startedAt - a.startedAt)[0].dir;
    return candidates.find(d => fs.existsSync(d)) || candidates[0];
}

// Same rule as tabPersist._suspectTombstone: a close-all no explicit close
// stands behind, written within seconds of the last healthy snapshot.
function intentionalCloseAll(meta, lastgood) {
    if (!meta || !meta.closedByUser) return false;
    if (Number(meta.userCloses) > 0) return true;
    if (tabCount(lastgood) < MIN_HEALTHY) return true;
    const gap = Date.parse(meta.savedAt) - Date.parse(lastgood.savedAt);
    if (!Number.isFinite(gap)) return true;
    return !(gap >= 0 && gap <= TOMBSTONE_SUSPECT_MS);
}

// Pure decision: what to do this tick, and the cursor to persist.
function decide({ liveCount, lastgood, meta, uptimeMs, cursor, now, config }) {
    const cur = { collapseSince: 0, lastRestoreAt: 0, ...(cursor || {}) };
    const lgCount = tabCount(lastgood);
    const closed = intentionalCloseAll(meta, lastgood);
    const collapsed = liveCount <= COLLAPSE_MAX && lgCount >= MIN_HEALTHY && !closed;
    if (!collapsed) {
        return { action: 'ok', cursor: { ...cur, collapseSince: 0 },
                 msg: `ok — live=${liveCount} lastgood=${lgCount}${closed ? ' closedByUser' : ''}` };
    }
    if (uptimeMs < config.minUptimeMs) {
        return { action: 'wait', cursor: cur,
                 msg: `collapse seen (live=${liveCount}, lastgood=${lgCount}) but daemon only ${Math.round(uptimeMs / 1000)}s old — inside rehydrate window; waiting` };
    }
    if (!cur.collapseSince) {
        return { action: 'arm', cursor: { ...cur, collapseSince: now },
                 msg: `collapse DETECTED (live=${liveCount}, lastgood=${lgCount}) — arming; will restore if it persists ${Math.round(config.debounceMs / 1000)}s` };
    }
    if (now - cur.collapseSince < config.debounceMs) {
        return { action: 'hold', cursor: cur,
                 msg: `collapse persisting ${Math.round((now - cur.collapseSince) / 1000)}s/${Math.round(config.debounceMs / 1000)}s (live=${liveCount}) — holding` };
    }
    if (now - (cur.lastRestoreAt || 0) < config.cooldownMs) {
        return { action: 'cooldown', cursor: cur,
                 msg: `collapse confirmed but within ${Math.round(config.cooldownMs / 1000)}s cooldown of last restore — holding` };
    }
    return { action: 'restore', cursor: cur,
             msg: `FLEET COLLAPSE CONFIRMED — live=${liveCount} tab(s), lastgood=${lgCount}.` };
}

function request(port, method, p, body, timeout) {
    return new Promise((resolve) => {
        const headers = {};
        let payload = null;
        if (body !== undefined) {
            payload = JSON.stringify(body);
            headers['content-type'] = 'application/json';
            headers['content-length'] = Buffer.byteLength(payload);
        }
        if (process.env.SOA_WEB_SESSION_TOKEN) headers.authorization = `Bearer ${process.env.SOA_WEB_SESSION_TOKEN}`;
        const req = http.request({ host: '127.0.0.1', port, method, path: p, headers, timeout }, (res) => {
            let b = ''; res.on('data', c => b += c); res.on('end', () => {
                let json = null; try { json = JSON.parse(b); } catch (_) {}
                resolve({ status: res.statusCode, json, raw: b });
            });
        });
        req.on('error', (e) => resolve({ status: 0, error: e.message }));
        req.on('timeout', () => { req.destroy(); resolve({ status: 0, error: 'timeout' }); });
        if (payload) req.write(payload);
        req.end();
    });
}

function notify(title, body) {
    try {
        execFileSync('soa-notify', ['-t', title, '-p', 'high', '-T', 'robot,recycle', '--also-msg', body],
            { stdio: 'ignore', timeout: 15000 });
    } catch (_) { /* best-effort; the log is the source of truth */ }
}

async function main() {
    const log = (msg) => console.log(`[${new Date().toISOString()}] soa-fleet-restore-watch: ${msg}`);
    const config = cfg();
    if (!config.enabled) { log('disabled via SOA_FLEET_RESTORE_ENABLE=0 — exiting'); return; }

    const SD = resolveStateDir();
    const CURSOR = path.join(SD, 'fleet-restore-watch.json');
    const saveCursor = (c) => { try { fs.writeFileSync(CURSOR, JSON.stringify(c, null, 2) + '\n'); } catch (_) {} };

    const lock = readJson(path.join(SD, 'daemon.lock'));
    if (!lock) { log(`no daemon.lock in ${SD} — daemon not up (watchdog-4010 owns liveness); noop`); return; }
    const port = lock.port || 4010;
    const startedAt = lock.startedAt ? Date.parse(lock.startedAt) : 0;

    // 15 s: under load (dozens of agents resuming) the daemon is slow, not dead.
    const tabsRes = await request(port, 'GET', '/api/tabs', undefined, 15000);
    const live = tabsRes.json && (Array.isArray(tabsRes.json) ? tabsRes.json : tabsRes.json.tabs);
    if (!Array.isArray(live)) { log(`daemon not answering /api/tabs on :${port} — leaving liveness to watchdog-4010; noop`); return; }

    const now = Date.now();
    const d = decide({
        liveCount: live.length,
        lastgood: readJson(path.join(SD, 'tabs.json.lastgood')),
        meta: readJson(path.join(SD, 'tabs.json')),
        uptimeMs: startedAt ? now - startedAt : Infinity,
        cursor: readJson(CURSOR),
        now, config,
    });
    if (d.action !== 'restore') {
        if (JSON.stringify(d.cursor) !== JSON.stringify(readJson(CURSOR) || {})) saveCursor(d.cursor);
        log(d.msg);
        return;
    }

    log(`${d.msg} [state ${SD}] ${config.dry ? 'DRY-RUN: would POST /api/fleet/restore.' : 'POST /api/fleet/restore…'}`);
    if (config.dry) { saveCursor({ ...d.cursor, collapseSince: 0 }); return; }

    const r = await request(port, 'POST', '/api/fleet/restore', {}, 120000);
    const out = r.json || {};
    const opened = Array.isArray(out.opened) ? out.opened.length : 0;
    if (r.status === 200 && out.ok) {
        const skipped = Array.isArray(out.skipped) ? out.skipped.length : 0;
        log(`restore ok — opened ${opened} tab(s) from ${out.from || '?'} (${skipped} skipped, resumed=${!!out.resumed})`);
        if (opened > 0) {
            notify('SoA fleet auto-recovered',
                `Fleet had collapsed to ${live.length} tab — reopened ${opened} tab(s) from ${out.from || 'the last-good snapshot'}.`);
        }
    } else {
        // Report a failure as a failure — never as "N spawned".
        log(`restore FAILED — HTTP ${r.status || 'n/a'} ${r.error || (r.raw || '').slice(0, 300)}`);
        notify('SoA fleet restore failed',
            `Fleet collapsed to ${live.length} tab and auto-restore failed (HTTP ${r.status || r.error}). Use Time Machine → Restore.`);
    }
    saveCursor({ ...d.cursor, collapseSince: 0, lastRestoreAt: Date.now() });
}

module.exports = { decide, resolveStateDir, intentionalCloseAll, cfg };

if (require.main === module) {
    main().catch((e) => { console.error('soa-fleet-restore-watch:', (e && e.stack) || e); process.exitCode = 1; });
}
