      inputSchema: { type: 'object', properties: { name: NAME, code: str('the code, verbatim'), language: str('e.g. python, shell, typescript (default text)'), title: str('optional human title'), description: str('optional one-line description'), tags: { type: 'array', items: { type: 'string' }, description: 'optional tags' }, overwrite: { type: 'boolean', description: 'replace an existing user snippet with this name' }, allow_secrets: { type: 'boolean', description: 'only for deliberate, non-sensitive examples that trip the secret filter' } }, required: ['name', 'code'], additionalProperties: false } },
    { name: 'list_snippets', title: 'List snippets', annotations: RO, description: 'List code snippets (user and preset), optionally filtered by words and/or one tag.',
