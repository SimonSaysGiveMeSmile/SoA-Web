      inputSchema: { type: 'object', properties: { name: NAME }, required: ['name'], additionalProperties: false } },
    { name: 'delete_snippet', title: 'Delete a snippet', annotations: D, description: 'Delete a user snippet. Presets are read-only. Requires confirm:true.',
      inputSchema: { type: 'object', properties: { name: NAME, confirm: { type: 'boolean', description: 'must be true' } }, required: ['name', 'confirm'], additionalProperties: false } },
    { name: 'search', title: 'Search the library', annotations: RO, description: 'Full-text search across skills and snippets (every word must match).',
      inputSchema: { type: 'object', properties: { query: str('words to find') }, required: ['query'], additionalProperties: false } },
    { name: 'export_skill', title: 'Mirror one skill natively', annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
