#!/usr/bin/env bash
#
# soa-notify — push a fleet-attention alert to the user's phone, for free.
#
# The fleet already has soa-msg (in-app CHAT bubble), but that's only seen when
# the user has SoA open. soa-notify reaches the user's phone as a real OS push
# notification even when SoA is closed — so the manager can flag a genuine
# blocker/decision and the user actually sees it.
#
# Default provider is ntfy.sh: free, no account, curl-to-send. The user installs
# the free ntfy app (iOS/Android) or opens the topic URL in a browser and
# subscribes to the topic in ~/.soa-web-local/notify.json. The topic is a random
# string that doubles as a shared secret.
#
# Usage:
#   soa-notify "api deploy is failing — need a decision"
#   soa-notify -t "Fleet blocker" -p high -T warning "web needs a login"
#   echo "piped body" | soa-notify -t "Heartbeat"
#   soa-notify --click "https://s0a.app" "tap to open the dashboard"
#   soa-notify --test           # send a self-test notification
#
# Flags:
#   -t <title>          notification title (default: "SoA fleet")
#   -p <priority>       min|low|default|high|max  (ntfy; default: default)
#   -T <tags>           comma list of ntfy tags/emojis (e.g. warning,robot)
#   --click <url>       URL opened when the notification is tapped
#   --also-msg          ALSO mirror the body into the in-app CHAT via soa-msg
#   --test              send a canned self-test and exit
#
# Config (~/.soa-web-local/notify.json): {provider, server, topic}. Env overrides:
#   SOA_NOTIFY_TOPIC, SOA_NOTIFY_SERVER, SOA_NOTIFY_PROVIDER.
#
# Exit: 0 on a delivered POST (HTTP 2xx), 75 when the push was DEFERRED by the
# shared push budget (below; --also-msg still reaches CHAT), other non-zero on a
# failure. Designed to be safe in launchd jobs (the heartbeat/supervisor can call it).
#
# Shared push budget ($STATE_DIR/.push-budget.json): every SoA script pushes
# through here, and ntfy.sh rate-limits per IP across all topics, so a burst of
# alerts (or soa-doors retrying) left every push at HTTP 429. Two guards:
#   - token bucket: at most SOA_NOTIFY_BUDGET (4) pushes per
#     SOA_NOTIFY_BUDGET_WINDOW seconds (600); a POST that never reached ntfy
#     (network error, HTTP 000) or got a 5xx gives its slot back;
#   - 429 circuit breaker: on a 429, no POST until Retry-After, or 5 → 15 → 30
#     min (SOA_NOTIFY_BACKOFF, seconds) on consecutive 429s; a 2xx resets it.
#     soa-doors reads and writes the same breaker.
# During either, nothing is POSTed and the exit is 75 (EX_TEMPFAIL), so callers
# log "push deferred (rate limited)" instead of FAILED. The budget fails open: a
# corrupt state file is dropped, and a crash in the check still sends. SOA_NOTIFY_NOW (epoch
# seconds) injects the clock for tests.

set -uo pipefail

STATE_DIR="${SOA_WEB_STATE_DIR:-$HOME/.soa-web-local}"
CFG="$STATE_DIR/notify.json"
# The config predates SOA_WEB_STATE_DIR: an install whose state dir moved still
# has its topic in the legacy dir, so read it there rather than go silent.
[ -f "$CFG" ] || { [ -f "$HOME/.soa-web-local/notify.json" ] && CFG="$HOME/.soa-web-local/notify.json"; }
BUDGET="$STATE_DIR/.push-budget.json"
EX_DEFERRED=75

jget() { # jget <key> < json
    python3 -c "import sys,json
try: print(json.load(sys.stdin).get('$1','') or '')
except Exception: print('')" 2>/dev/null
}

PROVIDER="${SOA_NOTIFY_PROVIDER:-}"
SERVER="${SOA_NOTIFY_SERVER:-}"
TOPIC="${SOA_NOTIFY_TOPIC:-}"
if [ -f "$CFG" ]; then
    [ -z "$PROVIDER" ] && PROVIDER="$(jget provider < "$CFG")"
    [ -z "$SERVER" ]   && SERVER="$(jget server   < "$CFG")"
    [ -z "$TOPIC" ]    && TOPIC="$(jget topic    < "$CFG")"
fi
PROVIDER="${PROVIDER:-ntfy}"
SERVER="${SERVER:-https://ntfy.sh}"

TITLE="SoA fleet"
PRIORITY="default"
TAGS=""
CLICK=""
ALSO_MSG=0
TEST=0
BODY=""

while [ $# -gt 0 ]; do
    case "$1" in
        -t) TITLE="$2"; shift 2;;
        -p) PRIORITY="$2"; shift 2;;
        -T) TAGS="$2"; shift 2;;
        --click) CLICK="$2"; shift 2;;
        --also-msg) ALSO_MSG=1; shift;;
        --test) TEST=1; shift;;
        --) shift; BODY="$*"; break;;
        -*) echo "soa-notify: unknown flag $1" >&2; shift;;
        *) BODY="${BODY:+$BODY }$1"; shift;;
    esac
done

# Body from stdin if not passed as args (and stdin is not a TTY).
if [ -z "$BODY" ] && [ ! -t 0 ]; then BODY="$(cat)"; fi

if [ "$TEST" = "1" ]; then
    TITLE="SoA fleet — test"
    BODY="✅ soa-notify is wired up. This is a self-test from the fleet manager. If you're reading this on your phone, the channel works."
    TAGS="${TAGS:-white_check_mark,robot}"
fi

[ -z "$BODY" ] && { echo "soa-notify: empty message (pass text or pipe stdin)" >&2; exit 2; }

# budget take | budget result <http code> <header file>. One mkdir lock (flock
# is not on stock macOS) serialises concurrent callers. The lock is held for
# milliseconds, so one still there after ~5 s is a crashed caller's: break it.
budget() {
    mkdir -p "$STATE_DIR" 2>/dev/null
    local lock="$BUDGET.lock" i=0
    while ! mkdir "$lock" 2>/dev/null; do
        i=$((i + 1)); [ "$i" -gt 50 ] && { rmdir "$lock" 2>/dev/null; mkdir "$lock" 2>/dev/null; break; }
        sleep 0.1
    done
    local out rc
    out="$(python3 - "$BUDGET" "$@" <<'PY'
import sys, json, os, time, email.utils
path, action = sys.argv[1], sys.argv[2]
env = os.environ
def num(name, default, cast=float):
    try: return cast(env.get(name) or default)
    except Exception: return cast(default)
now = num('SOA_NOTIFY_NOW', time.time())
cap = num('SOA_NOTIFY_BUDGET', 4, int)
win = num('SOA_NOTIFY_BUDGET_WINDOW', 600) or 600
try: ladder = [float(x) for x in (env.get('SOA_NOTIFY_BACKOFF') or '').split(',') if x.strip()]
except Exception: ladder = []
ladder = ladder or [300, 900, 1800]
# A state file another writer left corrupt is dropped, never trusted: a bad
# field must not hold every push "deferred" forever.
try:
    st = json.load(open(path))
    if not isinstance(st, dict): st = {}
    sent = [float(t) for t in st.get('sent', []) if isinstance(t, (int, float)) and now - win < t <= now + 5]
    until = float(st.get('blockedUntil') or 0)
    strikes = int(st.get('strikes') or 0)
except Exception:
    st, sent, until, strikes = {}, [], 0.0, 0
def hhmm(t): return time.strftime('%H:%M', time.localtime(t))
DEFER = 10   # the only code the caller treats as "held back"
rc, msg = 0, ''
if action == 'take':
    if until > now:
        rc, msg = DEFER, 'ntfy rate limited (429); retrying after %s' % hhmm(until)
    elif cap > 0 and len(sent) >= cap:
        rc, msg = DEFER, 'push budget spent (%d per %d min); next slot %s' % (cap, win // 60, hhmm(min(sent) + win))
    else:
        sent.append(now)
elif action == 'result':
    code = sys.argv[3]
    if code == '429':
        wait = 0
        try:
            for line in open(sys.argv[4], errors='replace'):
                k, _, v = line.partition(':')
                if k.strip().lower() == 'retry-after':
                    v = v.strip()
                    if v.isdigit(): wait = float(v)
                    else:
                        d = email.utils.parsedate_to_datetime(v)
                        wait = d.timestamp() - now if d else 0
        except Exception:
            pass
        step = ladder[min(strikes, len(ladder) - 1)]
        strikes += 1
        until = now + min(max(wait, step), 6 * 3600)
        msg = 'ntfy rate limited (429 #%d); no pushes until %s' % (strikes, hhmm(until))
    elif code[:1] == '2':
        strikes, until = 0, 0
    elif (code == '000' or code[:1] == '5') and sent:
        # Never reached ntfy (network) or ntfy failed: the slot is given back.
        sent.remove(max(sent))
st.update(sent=sent, blockedUntil=until, strikes=strikes)
tmp = '%s.%d.tmp' % (path, os.getpid())
with open(tmp, 'w') as f: json.dump(st, f)
os.replace(tmp, path)
print(msg)
sys.exit(rc)
PY
)"; rc=$?
    rmdir "$lock" 2>/dev/null
    [ -n "$out" ] && echo "$out"
    return $rc
}

send_ntfy() {
    [ -z "$TOPIC" ] && { echo "soa-notify: no ntfy topic configured ($CFG or SOA_NOTIFY_TOPIC)" >&2; return 3; }
    local url="${SERVER%/}/$TOPIC"
    local -a H=(-H "Title: $TITLE" -H "Priority: $PRIORITY")
    [ -n "$TAGS" ]  && H+=(-H "Tags: $TAGS")
    [ -n "$CLICK" ] && H+=(-H "Click: $CLICK")
    local out code err why hdr brc
    # Fails open: only the budget's own "held back" code (10) defers a push; a
    # crash in the budget check (bad env, unwritable state dir) still sends.
    why="$(budget take)"; brc=$?
    if [ "$brc" = "10" ]; then
        echo "soa-notify: push deferred (${why:-rate limited})" >&2
        return $EX_DEFERRED
    elif [ "$brc" != "0" ]; then
        echo "soa-notify: push budget check failed (rc $brc); sending anyway" >&2
    fi
    hdr="$(mktemp "${TMPDIR:-/tmp}/soa-notify.XXXXXX")"
    # %{errormsg} (curl >= 7.75) carries the transport's own reason (DNS, TLS,
    # timeout…) so a failed push says why instead of only "HTTP 000".
    out="$(curl -s -o /dev/null -D "$hdr" -w '%{http_code}|%{errormsg}' --max-time 15 \
        "${H[@]}" -d "$BODY" "$url" 2>/dev/null)"
    code="${out%%|*}"; err="${out#*|}"; [ "$err" = "$out" ] && err=""
    why="$(budget result "${code:-000}" "$hdr" 2>/dev/null)"
    rm -f "$hdr"
    if [ "${code:0:1}" = "2" ]; then
        echo "soa-notify: sent via ntfy → $url (HTTP $code)"
        return 0
    fi
    if [ "$code" = "429" ]; then
        echo "soa-notify: push deferred (${why:-ntfy rate limited (429)})" >&2
        return $EX_DEFERRED
    fi
    echo "soa-notify: ntfy POST failed (HTTP ${code:-000}${err:+: $err}) → $url" >&2
    return 1
}

rc=0
case "$PROVIDER" in
    ntfy) send_ntfy || rc=$?;;
    *) echo "soa-notify: unknown provider '$PROVIDER'" >&2; rc=4;;
esac

# Optional: also drop it in the in-app CHAT so it's visible inside SoA too.
if [ "$ALSO_MSG" = "1" ] && command -v soa-msg >/dev/null 2>&1; then
    printf '%s' "$BODY" | soa-msg >/dev/null 2>&1 || true
fi

exit $rc
